<?xml version="1.0" encoding="utf-8"?>
<!-- Today widget (TodayWidgetProvider): next dose and the day's progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/today_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/today_widget_ink_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/today_widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/today_widget_action"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/today_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/today_widget_ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/today_widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/today_widget_taken"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
