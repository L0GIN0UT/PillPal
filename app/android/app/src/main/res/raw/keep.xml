<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the icons from resource shrinking: the plugin looks the small icon
     up by name at run time, so reminders use @drawable/ic_stat_pillpal
     (flutter_local_notifications README, "Release build configuration"). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@mipmap/ic_launcher,@drawable/ic_stat_pillpal,@string/google_app_id,@string/google_api_key,@string/gcm_defaultSenderId,@string/project_id" />
