# Staging (field test) settings. Copy to .env next to docker-compose.yml on the server and replace
# every CHANGE_ME. NEVER commit a real .env. Guide: docs/staging.md
# Avoid '$' and spaces in values (compose interpolation); use URL-safe characters in passwords.

# --- image (the deploy workflow appends PILLPAL_IMAGE_TAG=<commit sha> to this file) ------------
# ghcr.io/<github owner in lower case>/pillpal-backend
PILLPAL_IMAGE=ghcr.io/CHANGE_ME_owner/pillpal-backend

# --- public address ------------------------------------------------------------------------------
# Host name only, no scheme: it is the API host, the invite-link host and the App Links host.
PUBLIC_DOMAIN=staging.example.com
# Host name of the catalog service (a separate host: the app talks to it without an account, and
# its requests are not mixed with the API's). Needs its own DNS record and certificate.
CATALOG_DOMAIN=catalog-staging.example.com
# Where the reverse proxy reaches the API (nginx recipe). Not published outside the host.
# API_PORT=8080
# API_BIND=127.0.0.1
# Compose network of the stack; change only if it collides with another Docker network. The API
# trusts X-Forwarded-For only from this subnet (override with FORWARDED_ALLOW_IPS).
# STAGING_SUBNET=172.29.40.0/24
# Set to "caddy" ONLY when the host has no reverse proxy yet (needs free ports 80 and 443).
# COMPOSE_PROFILES=caddy

# --- secrets -------------------------------------------------------------------------------------
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=CHANGE_ME_generate_a_random_secret_of_at_least_32_chars
# python3 -c 'import secrets; print(secrets.token_hex(24))'
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
REDIS_PASSWORD=CHANGE_ME_redis_password
# POSTGRES_USER=pillpal
# POSTGRES_DB=pillpal

# --- catalog (docs/staging.md section 12) --------------------------------------------------------
# ghcr.io/<github owner in lower case>/pillpal-catalog (the tag is PILLPAL_IMAGE_TAG, the same commit)
CATALOG_IMAGE=ghcr.io/CHANGE_ME_owner/pillpal-catalog
# Its own PostgreSQL server (service catalog-postgres). The admin account only creates the database
# and the role; the services connect as CATALOG_DB_USER. URL-safe characters, no '$'.
CATALOG_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_catalog_postgres_admin_password
CATALOG_DB_PASSWORD=CHANGE_ME_catalog_db_password
# CATALOG_POSTGRES_ADMIN_USER=catalog_admin
# CATALOG_DB_USER=catalog
# CATALOG_POSTGRES_DB=pillpal_catalog
# Service tokens: the catalog holds only SHA-256 digests, as name:digest[,name:digest]. Make a secret
# and its digest with
#   python3 -c "import secrets,hashlib; s=secrets.token_urlsafe(48); print(s, hashlib.sha256(s.encode()).hexdigest())"
# keep the secret in a password manager, put the digest here. Name tokens by role, not by person.
CATALOG_ADMIN_TOKENS=ops:CHANGE_ME_sha256_hex_digest_of_a_random_secret_64_chars_0000000000
# One per region; the name starts with the region (ru; ru-next while rotating).
CATALOG_INGEST_TOKENS=ru:CHANGE_ME_sha256_hex_digest_of_another_secret_64_chars_0000000000
# HMAC key of the rate-limit buckets, shared by every catalog process.
CATALOG_RATE_LIMIT_SALT=CHANGE_ME_random_value_of_at_least_16_chars
# Where the reverse proxy reaches the public catalog (nginx recipe). Not published outside the host.
# CATALOG_PORT=8081
# CATALOG_BIND=127.0.0.1
# Importers behind the owner's checklist (catalog/README.md "RU sources"); leave false until it is done.
# CATALOG_IMPORTER_ESKLP_ENABLED=false
# CATALOG_IMPORTER_GRLS_ENABLED=false
# Link of the backend worker to the private listener. Leave empty: staging refuses contributions, and
# the backend requires https here (the listener is plain http inside the compose network).
# CATALOG_INTERNAL_URL=
# CATALOG_INGEST_TOKEN=

# --- Android App Links (ADR 0009) ----------------------------------------------------------------
# SHA-256 of the key that signs the APK, JSON list, upper-case hex pairs separated by colons.
ANDROID_CERT_SHA256S=["AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99"]

# --- push: FCM project id; the service account key is secrets/fcm_service_account.json -----------
FCM_PROJECT_ID=CHANGE_ME_firebase_project_id

# --- e-mail over SMTP; the password is the file secrets/smtp_password -----------------------------
# Yandex 360: smtp.yandex.ru, Mail.ru: smtp.mail.ru (465 + ssl; 587 + starttls also works)
SMTP_HOST=smtp.yandex.ru
# Empty = 465 for ssl, 587 for starttls
SMTP_PORT=
SMTP_SECURITY=ssl
SMTP_USERNAME=CHANGE_ME@yandex.ru
# Must be the mailbox address (providers reject a foreign sender)
SMTP_FROM=PillPal <CHANGE_ME@yandex.ru>

# LOG_LEVEL=INFO
