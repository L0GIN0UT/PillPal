# Staging (field test) settings. Copy to .env next to docker-compose.yml on the server and replace
# every CHANGE_ME. NEVER commit a real .env. Guide: docs/staging.md
# Avoid '$' and spaces in values (compose interpolation); use URL-safe characters in passwords.

# --- image (the deploy workflow sets PILLPAL_IMAGE_TAG to the commit it built) -------------------
# ghcr.io/<github owner in lower case>/pillpal-backend
PILLPAL_IMAGE=ghcr.io/CHANGE_ME_owner/pillpal-backend
# PILLPAL_IMAGE_TAG=staging

# --- public address ------------------------------------------------------------------------------
# Host name only, no scheme: it is the API host, the invite-link host and the App Links host.
PUBLIC_DOMAIN=staging.example.com
# Where the reverse proxy reaches the API (nginx recipe). Not published outside the host.
# API_PORT=8080
# API_BIND=127.0.0.1
# Set to "caddy" ONLY when the host has no reverse proxy yet (needs free ports 80 and 443).
# COMPOSE_PROFILES=caddy

# --- secrets -------------------------------------------------------------------------------------
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=CHANGE_ME_generate_a_random_secret_of_at_least_32_chars
# python3 -c 'import secrets; print(secrets.token_hex(24))'
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
REDIS_PASSWORD=CHANGE_ME_redis_password
# POSTGRES_USER=pillpal
# POSTGRES_DB=pillpal

# --- Android App Links (ADR 0009) ----------------------------------------------------------------
# SHA-256 of the key that signs the APK, JSON list, upper-case hex pairs separated by colons.
ANDROID_CERT_SHA256S=["AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99"]

# --- push: FCM project id; the service account key is secrets/fcm_service_account.json -----------
FCM_PROJECT_ID=CHANGE_ME_firebase_project_id

# --- e-mail over SMTP; the password is the file secrets/smtp_password -----------------------------
# Yandex 360: smtp.yandex.ru, Mail.ru: smtp.mail.ru (465 + ssl; 587 + starttls also works)
SMTP_HOST=smtp.yandex.ru
# Empty = 465 for ssl, 587 for starttls
SMTP_PORT=
SMTP_SECURITY=ssl
SMTP_USERNAME=CHANGE_ME@yandex.ru
# Must be the mailbox address (providers reject a foreign sender)
SMTP_FROM=PillPal <CHANGE_ME@yandex.ru>

# LOG_LEVEL=INFO
