# Used only with COMPOSE_PROFILES=caddy. Caddy gets and renews the certificates by itself
# (needs: DNS A records of $PUBLIC_DOMAIN and $CATALOG_DOMAIN, and of $SITE_DOMAIN and
# www.$SITE_DOMAIN when it is set, -> this server, ports 80 and 443 open).
{
	# Caddy writes no access log unless a site has a `log` directive: none has one. Its own error
	# log (a failed upstream, a bad request) would still carry the request URI, the client address
	# and the headers, so those fields are removed from every Caddy log line. This matters most
	# for the catalog, where a URI or an address is something a person looked up (docs/staging.md).
	log {
		format filter {
			wrap json
			request>uri delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
		}
	}
}

# Headers of the landing page only (docs/staging.md "Landing page"): same-origin styles, scripts
# and fonts, no inline code, nothing else. The API sets its own headers.
(site_headers) {
	header {
		Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# The landing page itself: exactly / and the static files under /site/*, from the read-only folder
# ./site (index.html at its root, the assets in its site/ subfolder). No log directive here
# either: still no access log. Cache-Control only on success, so an error is never cached;
# dotfiles are never served.
(landing_files) {
	@site_page path /
	handle @site_page {
		import site_headers
		header {
			Cache-Control "public, max-age=300"
			match status 2xx 304
		}
		root * /srv/site
		rewrite * /index.html
		file_server {
			hide .*
		}
	}
	handle /site/* {
		import site_headers
		header {
			Cache-Control "public, max-age=86400"
			match status 2xx 304
		}
		root * /srv/site
		file_server {
			hide .*
		}
	}
}

# Where the landing page lives (docs/staging.md "Landing page"). The compose file sets
# LANDING_MODE from SITE_DOMAIN: "api_host" when SITE_DOMAIN is empty (also the default here, for
# a Caddy started without compose), "api_host_to_site_domain" when it is set. The mode picks one
# of the snippet pairs below at adapt time. This is how the SITE_DOMAIN and www.SITE_DOMAIN
# blocks exist only when SITE_DOMAIN is set: an address built from an empty variable would be a
# broken or bogus site (and a bogus host would make Caddy ask an ACME CA for a certificate), and
# a Caddyfile has no conditionals. A snippet that is never imported is never adapted. An unknown
# mode, or a SITE_DOMAIN Caddy cannot adapt, fails `caddy adapt`. A changed variable recreates the
# container, which then has no config at all (no fallback to the previous one, and the API and
# catalog hosts go down too), so the deploy checks SITE_DOMAIN first (check_site_domain.sh).
#
# Mode api_host (no SITE_DOMAIN): the landing page is served on the API host, as before.
(public_landing_api_host) {
	import landing_files
}
(site_hosts_api_host) {
}

# Mode api_host_to_site_domain: the landing page has its own host, www redirects to it for good,
# and the API host sends its old landing paths there. 302, not 301: the API host's root is not a
# stable address, and a browser caching a permanent redirect would outlive a later change.
(public_landing_api_host_to_site_domain) {
	# {uri} keeps the query string of the old address on both.
	redir / https://{$SITE_DOMAIN}{uri} 302
	redir /site/* https://{$SITE_DOMAIN}{uri} 302
}
(site_hosts_api_host_to_site_domain) {
	{$SITE_DOMAIN} {
		encode zstd gzip
		header Strict-Transport-Security "max-age=2592000"
		import landing_files
		# Only the landing page: the API is never proxied on this host.
		handle {
			import site_headers
			respond 404
		}
	}
	www.{$SITE_DOMAIN} {
		header Strict-Transport-Security "max-age=2592000"
		import site_headers
		redir https://{$SITE_DOMAIN}{uri} permanent
	}
}

import site_hosts_{$LANDING_MODE:api_host}

{$PUBLIC_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=2592000"

	# The landing page or the redirects to its own host (snippets above). The API has no route at
	# / or /site/*.
	import public_landing_{$LANDING_MODE:api_host}

	# Everything else is served by the API: /v1/*, /healthz, /readyz, /i (invite page) and
	# /.well-known/*. Caddy replaces any client X-Forwarded-For.
	handle {
		reverse_proxy api:8000
	}
}

# The global catalog: public reads only. Exactly these routes are proxied; everything else, in
# particular /admin* and /internal* (the private listener, which has no route here at all), is a
# 404 that never reaches the service.
{$CATALOG_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=2592000"
	request_body {
		max_size 8KB
	}

	@reads_post {
		method POST
		path /v1/search /v1/gtins/lookup /v1/products/get
	}
	@reads_get {
		method GET
		path /v1/sources /healthz /readyz
	}

	handle @reads_post {
		reverse_proxy catalog:8000
	}
	handle @reads_get {
		reverse_proxy catalog:8000
	}
	handle {
		respond 404
	}
}
