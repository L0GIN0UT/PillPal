# PillPal backend environment — one file per region stand.
# Copy to infra/.env (git-ignored) and replace every value marked CHANGE_ME.
# NEVER commit a real .env. Full variable reference: backend/README.md.

# --- required ---------------------------------------------------------------
# Data region of this stand: ru | eu (one deployment per region, separate databases).
REGION=ru
# dev | test | prod
ENVIRONMENT=dev
# >= 32 random characters, unique per region and environment.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=CHANGE_ME_generate_a_random_secret_of_at_least_32_chars

# --- database / cache (compose overrides the hosts with service names) ------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=pillpal
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_postgres_password@localhost:5432/pillpal
REDIS_URL=redis://localhost:6379/0

# Apply Alembic migrations on container start (1 = yes). Prefer a one-off job in production.
RUN_MIGRATIONS=1

# --- optional (defaults shown) ---------------------------------------------
LOG_LEVEL=INFO
# Dev only: print e-mail verification codes to the log. Rejected when ENVIRONMENT=prod.
LOG_EMAIL_CODES=false
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# EMAIL_CODE_TTL_SECONDS=900
# EMAIL_CODE_MAX_ATTEMPTS=5
# EMAIL_CODE_WINDOW_SECONDS=86400
# EMAIL_CODE_DAILY_CAP=5
# EMAIL_CODE_MAX_FAILED_PER_WINDOW=10
# RATE_LIMIT_AUTH_MAX_ATTEMPTS=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=900
# RATE_LIMIT_IP_MULTIPLIER=10
# PASSWORD_HASH_TIME_COST=3
# PASSWORD_HASH_MEMORY_KIB=65536
# PASSWORD_HASH_PARALLELISM=4
# DB_POOL_SIZE=10
# CORS_ORIGINS=[]

# --- relatives: invite links (see backend/README.md) -------------------------
# Bare https origin of invite links (…/i#<token>). Unset = a per-region placeholder
# under the reserved .invalid TLD that never resolves, until a domain is chosen.
# PUBLIC_LINK_BASE_URL=https://links.example.com
# App-link verification files (404 until set). Fingerprints: AA:BB:...:FF (32 bytes), JSON list.
# ANDROID_PACKAGE_NAME=app.example.pillpal
# ANDROID_CERT_SHA256S=["AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99"]
# APPLE_TEAM_ID=ABCDE12345
# IOS_BUNDLE_ID=app.example.pillpal
# INVITE_TTL_SECONDS=604800
# GUARDIAN_INVITE_TTL_SECONDS=86400
# MAX_ACTIVE_INVITES_PER_PROFILE=5
# MAX_ACCESS_SCOPES_PER_USER=100
# --- account deletion grace (ADR 0010) ----------------------------------------
# ACCOUNT_DELETION_GRACE_DAYS=30
# ACCOUNT_ERASURE_JOB_INTERVAL_SECONDS=3600
# ACCOUNT_ERASURE_BATCH_SIZE=50
# ACCOUNT_RESTORE_TICKET_TTL_SECONDS=600
# MANAGED_ARCHIVE_RETENTION_DAYS=365
# INVITE_REPLAY_WINDOW_SECONDS=86400
# INVITE_RETENTION_DAYS=30
# Soft limits (relatives, PDF reports) stay off until payments exist.
# FEATURE_SOFT_LIMITS=false
# SOFT_LIMIT_RELATIVES=3
