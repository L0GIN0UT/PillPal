{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pillpal.app/spec/dose-state-vectors/schema.json",
  "title": "PillPal dose-state test vector file",
  "description": "Shape of every spec/dose-state-vectors/*.json file except this one. Enforced (with extra consistency checks) by spec/validate_vectors.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "description": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "instant": {
      "description": "UTC instant, second precision with an optional fraction of 1..6 digits (microseconds).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "occurrenceKey": {
      "description": "{schedule_id}/{YYYY-MM-DD}T{HH:MM} (docs/spec/schedule.md).",
      "type": "string",
      "pattern": "^.+/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at", "occurrence_key"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["taken", "skipped", "snoozed", "undo"]},
        "at": {"$ref": "#/$defs/instant"},
        "occurrence_key": {"oneOf": [{"$ref": "#/$defs/occurrenceKey"}, {"type": "null"}]},
        "target_event_id": {"type": "string", "minLength": 1, "description": "Required for undo, forbidden otherwise."},
        "snooze_until": {"$ref": "#/$defs/instant", "description": "Required for snoozed, forbidden otherwise; after 'at', at most 24 hours later."}
      }
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "type", "at"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["taken", "skipped"]},
        "at": {"$ref": "#/$defs/instant"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["now", "grace_minutes", "expected"],
      "properties": {
        "now": {"$ref": "#/$defs/instant"},
        "grace_minutes": {"type": "integer", "minimum": 0},
        "expected": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "occurrence_key", "occurrence_at", "events", "expected"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string"},
        "occurrence_key": {"$ref": "#/$defs/occurrenceKey"},
        "occurrence_at": {"$ref": "#/$defs/instant"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mark", "snooze_until", "due"],
          "properties": {
            "mark": {"oneOf": [{"$ref": "#/$defs/mark"}, {"type": "null"}]},
            "snooze_until": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]},
            "due": {"$ref": "#/$defs/instant"}
          }
        },
        "missed": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}}
      }
    }
  }
}
