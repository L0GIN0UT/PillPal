{
  "description": "kind=daily: single and multiple times, per-slot doses, normalisation, exact [from, to) boundaries, year boundary, leap day.",
  "cases": [
    {
      "name": "daily_single_time_utc",
      "schedule_id": "3f2a9c1e-7b4d-4e8a-9c1f-2d6b8e0a4c71",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-16",
        "end_date": null,
        "times": [{"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}}]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-16T00:00:00Z", "to": "2026-10-19T00:00:00Z"},
      "expected": [
        {"key": "3f2a9c1e-7b4d-4e8a-9c1f-2d6b8e0a4c71/2026-10-16T08:00", "at_utc": "2026-10-16T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "3f2a9c1e-7b4d-4e8a-9c1f-2d6b8e0a4c71/2026-10-17T08:00", "at_utc": "2026-10-17T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "3f2a9c1e-7b4d-4e8a-9c1f-2d6b8e0a4c71/2026-10-18T08:00", "at_utc": "2026-10-18T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
    {
      "name": "daily_three_times_different_doses_moscow",
      "description": "Europe/Moscow is UTC+3 all year. 21:30 on the day before the window (18:30Z) and 08:00 on 2026-11-04 (05:00Z) fall outside.",
      "schedule_id": "sched-d02",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-16",
        "times": [
          {"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}},
          {"time": "14:00", "dose": {"amount": "0.5", "unit": "tablet"}},
          {"time": "21:30", "dose": {"amount": "2.5", "unit": "ml"}}
        ]
      },
      "tz": "Europe/Moscow",
      "window": {"from": "2026-11-02T00:00:00Z", "to": "2026-11-04T00:00:00Z"},
      "expected": [
        {"key": "sched-d02/2026-11-02T08:00", "at_utc": "2026-11-02T05:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-d02/2026-11-02T14:00", "at_utc": "2026-11-02T11:00:00Z", "dose_amount": "0.5", "dose_unit": "tablet"},
        {"key": "sched-d02/2026-11-02T21:30", "at_utc": "2026-11-02T18:30:00Z", "dose_amount": "2.5", "dose_unit": "ml"},
        {"key": "sched-d02/2026-11-03T08:00", "at_utc": "2026-11-03T05:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-d02/2026-11-03T14:00", "at_utc": "2026-11-03T11:00:00Z", "dose_amount": "0.5", "dose_unit": "tablet"},
        {"key": "sched-d02/2026-11-03T21:30", "at_utc": "2026-11-03T18:30:00Z", "dose_amount": "2.5", "dose_unit": "ml"}
      ]
    },
    {
      "name": "daily_unsorted_times_and_amount_normalisation",
      "description": "Slots are given out of order; amounts '0.50' and '2.000' normalise to '0.5' and '2'; '12.125' keeps three fractional digits.",
      "schedule_id": "sched-d03",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-01",
        "end_date": null,
        "times": [
          {"time": "20:00", "dose": {"amount": "0.50", "unit": "ml"}},
          {"time": "08:00", "dose": {"amount": "2.000", "unit": "mg"}},
          {"time": "13:05", "dose": {"amount": "12.125", "unit": "drop"}}
        ]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-16T00:00:00Z", "to": "2026-10-17T00:00:00Z"},
      "expected": [
        {"key": "sched-d03/2026-10-16T08:00", "at_utc": "2026-10-16T08:00:00Z", "dose_amount": "2", "dose_unit": "mg"},
        {"key": "sched-d03/2026-10-16T13:05", "at_utc": "2026-10-16T13:05:00Z", "dose_amount": "12.125", "dose_unit": "drop"},
        {"key": "sched-d03/2026-10-16T20:00", "at_utc": "2026-10-16T20:00:00Z", "dose_amount": "0.5", "dose_unit": "ml"}
      ]
    },
