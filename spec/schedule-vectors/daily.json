    {
      "name": "daily_window_from_is_inclusive_to_is_exclusive",
      "description": "Occurrence exactly at 'from' is included, the one exactly at 'to' is excluded.",
      "schedule_id": "sched-d05",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-01",
        "times": [{"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}}]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-17T08:00:00Z", "to": "2026-10-18T08:00:00Z"},
      "expected": [
        {"key": "sched-d05/2026-10-17T08:00", "at_utc": "2026-10-17T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
    {
      "name": "daily_window_shifted_by_one_second",
      "description": "Same rule as the previous case, window shifted by +1 s: the 17th is now before 'from', the 18th is inside.",
      "schedule_id": "sched-d05",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-01",
        "times": [{"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}}]
