      "window": {"from": "2026-12-31T00:00:00Z", "to": "2027-01-02T00:00:00Z"},
      "expected": [
        {"key": "sched-d08/2026-12-31T23:30", "at_utc": "2026-12-31T14:30:00Z", "dose_amount": "2", "dose_unit": "tablet"},
        {"key": "sched-d08/2027-01-01T07:00", "at_utc": "2026-12-31T22:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-d08/2027-01-01T23:30", "at_utc": "2027-01-01T14:30:00Z", "dose_amount": "2", "dose_unit": "tablet"},
        {"key": "sched-d08/2027-01-02T07:00", "at_utc": "2027-01-01T22:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
