    {
      "name": "daily_year_boundary_tokyo",
      "description": "Asia/Tokyo is UTC+9. Local 2026-12-31 07:00 is 2026-12-30T22:00Z (outside); local 2027-01-02 23:30 is 2027-01-02T14:30Z (outside).",
