      "expected": [
        {"key": "sched-d05/2026-10-18T08:00", "at_utc": "2026-10-18T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
    {
      "name": "daily_empty_window",
