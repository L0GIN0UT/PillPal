{
  "description": "Course bounds: start_date and end_date are inclusive LOCAL dates and combine with every kind.",
  "cases": [
    {
      "name": "course_end_date_is_inclusive",
      "schedule_id": "sched-c01",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-16",
        "end_date": "2026-10-20",
        "times": [{"time": "21:00", "dose": {"amount": "1", "unit": "tablet"}}]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-14T00:00:00Z", "to": "2026-10-25T00:00:00Z"},
      "expected": [
        {"key": "sched-c01/2026-10-16T21:00", "at_utc": "2026-10-16T21:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-c01/2026-10-17T21:00", "at_utc": "2026-10-17T21:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-c01/2026-10-18T21:00", "at_utc": "2026-10-18T21:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-c01/2026-10-19T21:00", "at_utc": "2026-10-19T21:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-c01/2026-10-20T21:00", "at_utc": "2026-10-20T21:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
    {
      "name": "course_single_day",
      "description": "start_date == end_date is a one-day course.",
      "schedule_id": "sched-c02",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-16",
        "end_date": "2026-10-16",
        "times": [
          {"time": "08:00", "dose": {"amount": "2", "unit": "tablet"}},
          {"time": "20:00", "dose": {"amount": "1", "unit": "tablet"}}
        ]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-15T00:00:00Z", "to": "2026-10-18T00:00:00Z"},
      "expected": [
        {"key": "sched-c02/2026-10-16T08:00", "at_utc": "2026-10-16T08:00:00Z", "dose_amount": "2", "dose_unit": "tablet"},
        {"key": "sched-c02/2026-10-16T20:00", "at_utc": "2026-10-16T20:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
    {
      "name": "course_finished_before_window",
      "schedule_id": "sched-c03",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-01",
        "end_date": "2026-10-10",
        "times": [{"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}}]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-16T00:00:00Z", "to": "2026-10-20T00:00:00Z"},
      "expected": []
    },
    {
      "name": "course_starts_after_window",
      "schedule_id": "sched-c04",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-11-01",
        "end_date": "2026-11-10",
        "times": [{"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}}]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-16T00:00:00Z", "to": "2026-10-20T00:00:00Z"},
      "expected": []
    },
    {
      "name": "course_bounds_are_local_dates_los_angeles",
      "description": "PDT = UTC-7. The last day 2026-10-20 23:00 local is 2026-10-21T06:00Z and still belongs to the course.",
      "schedule_id": "sched-c05",
      "rule": {
        "v": 1,
        "kind": "daily",
        "start_date": "2026-10-16",
        "end_date": "2026-10-20",
        "times": [{"time": "23:00", "dose": {"amount": "10", "unit": "ml"}}]
      },
      "tz": "America/Los_Angeles",
      "window": {"from": "2026-10-19T00:00:00Z", "to": "2026-10-23T00:00:00Z"},
      "expected": [
        {"key": "sched-c05/2026-10-18T23:00", "at_utc": "2026-10-19T06:00:00Z", "dose_amount": "10", "dose_unit": "ml"},
        {"key": "sched-c05/2026-10-19T23:00", "at_utc": "2026-10-20T06:00:00Z", "dose_amount": "10", "dose_unit": "ml"},
        {"key": "sched-c05/2026-10-20T23:00", "at_utc": "2026-10-21T06:00:00Z", "dose_amount": "10", "dose_unit": "ml"}
      ]
    },
    {
      "name": "course_weekdays_with_bounds",
      "description": "Mondays only; course Wed 2026-10-14 .. Mon 2026-10-26 (inclusive), so Monday 10-12 is before the course and 11-02 after it.",
      "schedule_id": "sched-c06",
      "rule": {
        "v": 1,
        "kind": "weekdays",
        "start_date": "2026-10-14",
        "end_date": "2026-10-26",
        "weekdays": [1],
        "times": [{"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}}]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-01T00:00:00Z", "to": "2026-11-30T00:00:00Z"},
      "expected": [
        {"key": "sched-c06/2026-10-19T08:00", "at_utc": "2026-10-19T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-c06/2026-10-26T08:00", "at_utc": "2026-10-26T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
    {
      "name": "course_interval_with_bounds_kolkata",
      "description": "Every 2 days 2026-10-01 .. 2026-10-07 -> 1, 3, 5, 7. Asia/Kolkata is UTC+05:30, so 09:00 local = 03:30Z.",
      "schedule_id": "sched-c07",
      "rule": {
        "v": 1,
        "kind": "interval_days",
        "start_date": "2026-10-01",
        "end_date": "2026-10-07",
        "interval_days": 2,
        "times": [{"time": "09:00", "dose": {"amount": "1", "unit": "unit"}}]
      },
      "tz": "Asia/Kolkata",
      "window": {"from": "2026-09-30T00:00:00Z", "to": "2026-10-31T00:00:00Z"},
      "expected": [
        {"key": "sched-c07/2026-10-01T09:00", "at_utc": "2026-10-01T03:30:00Z", "dose_amount": "1", "dose_unit": "unit"},
        {"key": "sched-c07/2026-10-03T09:00", "at_utc": "2026-10-03T03:30:00Z", "dose_amount": "1", "dose_unit": "unit"},
        {"key": "sched-c07/2026-10-05T09:00", "at_utc": "2026-10-05T03:30:00Z", "dose_amount": "1", "dose_unit": "unit"},
        {"key": "sched-c07/2026-10-07T09:00", "at_utc": "2026-10-07T03:30:00Z", "dose_amount": "1", "dose_unit": "unit"}
      ]
    }
  ]
}
