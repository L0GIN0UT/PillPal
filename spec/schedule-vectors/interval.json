{
  "description": "kind=interval_days: qualifying dates are start_date + k*n calendar days (k >= 0), regardless of where the window starts.",
  "cases": [
    {
      "name": "interval_every_2_days_from_start",
      "schedule_id": "sched-i01",
      "rule": {
        "v": 1,
        "kind": "interval_days",
        "start_date": "2026-10-16",
        "end_date": null,
        "interval_days": 2,
        "times": [{"time": "08:00", "dose": {"amount": "1", "unit": "tablet"}}]
      },
      "tz": "UTC",
      "window": {"from": "2026-10-16T00:00:00Z", "to": "2026-10-23T00:00:00Z"},
      "expected": [
        {"key": "sched-i01/2026-10-16T08:00", "at_utc": "2026-10-16T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
