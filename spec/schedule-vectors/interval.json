        {"key": "sched-i01/2026-10-20T08:00", "at_utc": "2026-10-20T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"},
        {"key": "sched-i01/2026-10-22T08:00", "at_utc": "2026-10-22T08:00:00Z", "dose_amount": "1", "dose_unit": "tablet"}
      ]
    },
