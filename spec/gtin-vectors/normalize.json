{
  "description": "Normalization, classification and the gtin14_to_gtin13 / ndc_to_gtin14 helpers (docs/spec/gtin.md sections 1-3, 6).",
  "cases": [
    {
      "name": "gtin13_plain",
      "description": "13 digits are padded with one zero; prefix 460 is a company range.",
      "op": "normalize",
      "input": "4607012345677",
      "expected": {
        "gtin14": "04607012345677",
        "source_length": 13,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin13_poland",
      "description": "Prefix 590.",
      "op": "normalize",
      "input": "5901234123457",
      "expected": {
        "gtin14": "05901234123457",
        "source_length": 13,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin13_germany",
      "description": "Prefix 400.",
      "op": "normalize",
      "input": "4006381333931",
      "expected": {
        "gtin14": "04006381333931",
        "source_length": 13,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin12_upc_a",
      "description": "12 digits are padded with two zeros.",
      "op": "normalize",
      "input": "036000291452",
      "expected": {
        "gtin14": "00036000291452",
        "source_length": 12,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin8_plain",
      "description": "8 digits are padded with six zeros; first digit 9.",
      "op": "normalize",
      "input": "96385074",
      "expected": {
        "gtin14": "00000096385074",
        "source_length": 8,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin8_prefix_7",
      "description": "GTIN-8 starting with 7.",
      "op": "normalize",
      "input": "73513537",
      "expected": {
        "gtin14": "00000073513537",
        "source_length": 8,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin14_indicator_1",
      "description": "14 digits are kept as they are; indicator 1.",
      "op": "normalize",
      "input": "14006381333938",
      "expected": {
        "gtin14": "14006381333938",
        "source_length": 14,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin14_indicator_0",
      "description": "A GTIN-13 already padded to 14 digits normalizes to itself, source length 14.",
      "op": "normalize",
      "input": "04006381333931",
      "expected": {
        "gtin14": "04006381333931",
        "source_length": 14,
        "classification": "shareable"
      }
    },
    {
      "name": "spaces_stripped",
      "description": "Spaces anywhere are removed.",
      "op": "normalize",
      "input": "4 006381 333931",
      "expected": {
        "gtin14": "04006381333931",
        "source_length": 13,
        "classification": "shareable"
      }
    },
    {
      "name": "hyphens_stripped",
      "description": "Hyphens anywhere are removed.",
      "op": "normalize",
      "input": "4006-3813-33931",
      "expected": {
        "gtin14": "04006381333931",
        "source_length": 13,
        "classification": "shareable"
      }
    },
    {
      "name": "surrounding_spaces",
      "description": "Leading and trailing spaces are removed.",
      "op": "normalize",
      "input": "  4006381333931  ",
      "expected": {
        "gtin14": "04006381333931",
        "source_length": 13,
        "classification": "shareable"
      }
    },
    {
      "name": "mixed_separators",
      "description": "Spaces and hyphens mixed.",
      "op": "normalize",
      "input": "400-638 133-3931",
      "expected": {
        "gtin14": "04006381333931",
        "source_length": 13,
        "classification": "shareable"
      }
    },
    {
      "name": "gtin12_hyphenated",
      "description": "UPC-A as printed under a barcode.",
      "op": "normalize",
      "input": "0-36000-29145-2",
      "expected": {
        "gtin14": "00036000291452",
        "source_length": 12,
        "classification": "shareable"
      }
    },
    {
      "name": "length_empty",
      "description": "Length after stripping is not 8, 12, 13 or 14.",
      "op": "normalize",
      "input": "",
      "expected": {
        "error": "invalid_length"
      }
    },
    {
      "name": "length_only_spaces",
      "description": "Length after stripping is not 8, 12, 13 or 14.",
      "op": "normalize",
      "input": "   ",
      "expected": {
        "error": "invalid_length"
      }
    },
    {
      "name": "length_only_separators",
