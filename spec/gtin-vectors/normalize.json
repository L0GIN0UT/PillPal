    {
      "name": "chars_letter_at_end",
      "description": "Letter in place of the check digit.",
      "op": "normalize",
      "input": "400638133393X",
      "expected": {
        "error": "invalid_characters"
      }
    },
    {
      "name": "chars_lowercase_inside",
      "description": "Lowercase letter inside.",
      "op": "normalize",
      "input": "40063a1333931",
      "expected": {
        "error": "invalid_characters"
      }
    },
    {
      "name": "chars_letters_only",
      "description": "Characters are checked before the length.",
      "op": "normalize",
      "input": "ABC",
      "expected": {
        "error": "invalid_characters"
      }
    },
    {
      "name": "chars_short_with_letter",
      "description": "Characters are checked before the length.",
      "op": "normalize",
      "input": "12ab",
      "expected": {
        "error": "invalid_characters"
      }
    },
    {
      "name": "chars_arabic_indic_digits",
      "description": "Unicode decimal digits are not digits of the contract.",
      "op": "normalize",
      "input": "\u0664\u0660\u0660\u0666\u0663\u0668\u0661\u0663\u0663\u0663\u0669\u0663\u0661",
      "expected": {
        "error": "invalid_characters"
      }
    },
    {
      "name": "chars_fullwidth_digits",
      "description": "Fullwidth digits are not digits of the contract.",
      "op": "normalize",
      "input": "\uff14\uff10\uff10\uff16\uff13\uff18\uff11\uff13\uff13\uff13\uff19\uff13\uff11",
      "expected": {
        "error": "invalid_characters"
      }
    },
    {
      "name": "chars_tab_inside",
      "description": "Only spaces and hyphens are stripped, not tabs.",
      "op": "normalize",
      "input": "4006381\t333931",
      "expected": {
        "error": "invalid_characters"
      }
    },
    {
      "name": "chars_no_break_space",
      "description": "NO-BREAK SPACE is not a space.",
      "op": "normalize",
      "input": "4006381\u00a0333931",
