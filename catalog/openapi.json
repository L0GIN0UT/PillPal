              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Product",
        "tags": [
          "products"
        ]
      }
    },
    "/v1/search": {
      "post": {
        "description": "Products (or substances) by brand, INN or barcode digits; own market first (D6).",
