  "info": {
    "description": "Global medicine catalog: public reference data, no personal data.",
    "title": "PillPal Catalog",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness: the process is up. Does not touch dependencies.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness: the database answers. Redis is not checked, rate limiting fails open.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/gtins/lookup": {
      "post": {
        "description": "The product behind a GTIN: found, unknown, restricted or disputed (ADR 0014).",
        "operationId": "lookup_v1_gtins_lookup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GtinLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GtinLookupResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lookup",
        "tags": [
          "gtins"
        ]
      }
    },
    "/v1/products/get": {
      "post": {
        "description": "The card of one product, withdrawn rows included (user medications reference them).",
        "operationId": "get_product_v1_products_get_post",
        "requestBody": {
          "content": {
            "application/json": {
